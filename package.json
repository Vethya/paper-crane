{
  "private": true,
  "name": "resume-manager",
  "version": "3.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "dev": "next dev -p 3026",
    "start": "next start -p 3026",
    "build": "next build",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project storybook",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "postinstall": "node scripts/copy-siglum-worker.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.53",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@siglum/engine": "0.1.4",
    "ai": "^6.0.141",
    "archiver": "^7.0.1",
    "better-auth": "^1.5.4",
    "canvas": "^2.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "common-tags": "^1.8.2",
    "framer-motion": "^12.38.0",
    "jotai": "^2.8.3",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.4",
    "next": "15.5.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "react-icons": "^5.4.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^9.1.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/archiver": "^6.0.3",
    "@types/common-tags": "^1.8.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "storybook": "10.6.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "eslintConfig": {
    "root": true,
    "ignorePatterns": ["storybook-static"],
    "extends": [
      "plugin:react/recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@next/next/recommended"
    ],
    "plugins": [
      "@typescript-eslint",
      "react-hooks"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2018,
      "sourceType": "module"
    },
    "settings": {
      "react": {
        "pragma": "React",
        "version": "detect"
      }
    },
    "rules": {
      "no-console": "warn",
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "error",
      "react/prop-types": "off",
      "react/react-in-jsx-scope": "off",
      "react/display-name": "off",
      "@typescript-eslint/no-empty-function": "off",
      "@typescript-eslint/explicit-module-boundary-types": "off",
      "@typescript-eslint/no-empty-interface": "off",
      "@typescript-eslint/ban-types": "off",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "args": "none"
        }
      ],
      "@typescript-eslint/no-inferrable-types": "off"
    }
  }
}
